// Generates docs/rbac-matrix.md and database/seeds/0001_permissions.sql from the
// permission registry so documentation and seed data can't drift from the code.
import { writeFileSync } from "node:fs";
import { PERMISSIONS, ROLES, ROLE_PERMISSIONS } from "../src/lib/permissions/registry.ts";

type Role = keyof typeof ROLES;
type Perm = keyof typeof PERMISSIONS;
const roles = Object.keys(ROLES) as Role[];
const perms = Object.keys(PERMISSIONS) as Perm[];

const short: Record<Role, string> = {
  super_admin: "SA",
  founder: "FD",
  sales_manager: "SM",
  sales_executive: "SE",
  account_manager: "AM",
  business_analyst: "BA",
  technical_lead: "TL",
  project_manager: "PM",
  finance_manager: "FM",
  accountant: "AC",
  hr_manager: "HR",
  employee: "EM",
  auditor: "AU",
  client_user: "CU",
};

let md =
  "# RBAC matrix\n\n_Generated by `npm run docs:rbac` from `src/lib/permissions/registry.ts`. Do not edit by hand._\n\n";
md +=
  "The UI hides what a role can't do; the backend must enforce every row below independently.\n\n";
md += "**Roles:** " + roles.map((r) => `${short[r]} = ${ROLES[r]}`).join(" · ") + "\n\n";
md += `| Permission | ${roles.map((r) => short[r]).join(" | ")} |\n|---|${roles.map(() => ":-:").join("|")}|\n`;
for (const p of perms)
  md += `| \`${p}\` — ${PERMISSIONS[p]} | ${roles.map((r) => (ROLE_PERMISSIONS[r].includes(p) ? "✓" : "")).join(" | ")} |\n`;
md += `
## Record-level rules (in addition to the matrix)

| Rule | Where enforced |
|---|---|
| Lead visibility: \`leads.view_all\` → all; \`leads.view_team\` → own + same team; \`leads.view_own\` → own only | \`canViewLead\` (src/lib/permissions/access.ts); backend query scoping |
| Editing a lead requires \`leads.update\` **and** visibility of that lead | \`canEditLead\` |
| Reassigning requires \`leads.assign\`; target must be inside the assigner's scope | demo adapter \`assignableUsers\`; backend assignment service |
| Records outside scope respond **404**, not 403, so their existence isn't revealed | demo adapter; backend contract |
| Duplicate checks reveal only visible matches; others are counted, not shown | \`findDuplicates\` |
| Auditor is read-only everywhere | role matrix + tests |
| Client users get no internal permissions; portal access is a separate, client-scoped surface (Sprint 4) | role matrix |
`;
writeFileSync("docs/rbac-matrix.md", md);

const esc = (s: string) => s.replace(/'/g, "''");
let sql =
  "-- Generated by `npm run docs:rbac` from src/lib/permissions/registry.ts. Idempotent.\n-- Usage: psql -v org_id=<uuid> -f database/seeds/0001_permissions.sql\nBEGIN;\n";
sql +=
  "INSERT INTO permissions (key, description) VALUES\n" +
  perms.map((p) => `  ('${p}', '${esc(PERMISSIONS[p])}')`).join(",\n") +
  "\nON CONFLICT (key) DO UPDATE SET description = EXCLUDED.description;\n\n";
sql +=
  "INSERT INTO roles (organization_id, key, name, is_system) VALUES\n" +
  roles.map((r) => `  (:'org_id', '${r}', '${esc(ROLES[r])}', true)`).join(",\n") +
  "\nON CONFLICT (organization_id, key) DO UPDATE SET name = EXCLUDED.name;\n\n";
sql +=
  "DELETE FROM role_permissions rp USING roles r WHERE rp.role_id = r.id AND r.organization_id = :'org_id' AND r.is_system;\n";
sql +=
  "INSERT INTO role_permissions (role_id, permission_key)\nSELECT r.id, v.permission_key FROM roles r JOIN (VALUES\n";
sql += roles.flatMap((r) => ROLE_PERMISSIONS[r].map((p) => `  ('${r}', '${p}')`)).join(",\n");
sql +=
  "\n) AS v(role_key, permission_key) ON v.role_key = r.key WHERE r.organization_id = :'org_id';\nCOMMIT;\n";
writeFileSync("database/seeds/0001_permissions.sql", sql);
console.log(
  `Wrote docs/rbac-matrix.md and database/seeds/0001_permissions.sql (${roles.length} roles, ${perms.length} permissions).`,
);
