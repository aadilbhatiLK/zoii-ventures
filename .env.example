# Zoii Business OS — frontend configuration.
# Every NEXT_PUBLIC_* value is shipped to the browser. Never put secrets here.

# Data source: "demo" (in-browser demo adapter, clearly labelled) or "api" (real backend).
# Defaults to "demo" in development. In production it MUST be set explicitly.
NEXT_PUBLIC_DATA_MODE=demo

# Required when NEXT_PUBLIC_DATA_MODE=api. Base URL of the backend (versioned at /api/v1).
NEXT_PUBLIC_API_BASE_URL=

# Production safety latch. A production build refuses to run in demo mode unless this
# is exactly "true" (e.g. a Vercel preview used for design review). A permanent
# "Demo data" banner is shown whenever demo mode is active.
NEXT_PUBLIC_ALLOW_DEMO_IN_PRODUCTION=false
