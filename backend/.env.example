# Zoii Business OS — API configuration. Server-side only: never expose these to the browser.

# PostgreSQL connection. Leave unset in development to use embedded PGlite (PGLITE_DIR).
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DIR=.data/pglite

PORT=4000
HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (https only in production).
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP secrets and bank details. Required in production.
DATA_ENCRYPTION_KEY=
SESSION_HOURS=8
# Set when the API sits behind a load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Message delivery. "console" prints to the server log (development only); "none" disables.
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Development only (refused in production): load fictional demo data and accept 000000 as OTP/MFA code.
SEED_DEMO=true
AUTH_DEV_STATIC_CODES=true
# Production: apply migrations as a release step (npm run migrate), not on boot.
MIGRATE_ON_START=
WORKER_INTERVAL_MS=60000
