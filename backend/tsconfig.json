{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["../src/*"] },
    "noEmit": true
  },
  "include": ["src", "tests", "../src/lib/api/contracts.ts", "../src/lib/permissions", "../src/lib/validation"]
}
